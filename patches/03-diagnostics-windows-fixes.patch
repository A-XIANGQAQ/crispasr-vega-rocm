+#ifdef CRISPASR_VERSION_STR_RAW
+#define CRISPASR_VERSION_STR CRISPASR_STR(CRISPASR_VERSION_STR_RAW)
+#endif
+#ifdef CRISPASR_GIT_SHA1_RAW
+#define CRISPASR_GIT_SHA1 CRISPASR_STR(CRISPASR_GIT_SHA1_RAW)
+#endif
+#ifdef CRISPASR_GIT_DATE_RAW
+#define CRISPASR_GIT_DATE CRISPASR_STR(CRISPASR_GIT_DATE_RAW)
+#endif
+#ifdef CRISPASR_GIT_SUBJECT_RAW
+#define CRISPASR_GIT_SUBJECT CRISPASR_STR(CRISPASR_GIT_SUBJECT_RAW)
+#endif
+#ifdef CRISPASR_BUILD_DATE_RAW
+#define CRISPASR_BUILD_DATE CRISPASR_STR(CRISPASR_BUILD_DATE_RAW)
+#endif
+#ifdef CRISPASR_BUILD_TYPE_RAW
+#define CRISPASR_BUILD_TYPE CRISPASR_STR(CRISPASR_BUILD_TYPE_RAW)
+#endif
+
 #ifndef CRISPASR_VERSION_STR
